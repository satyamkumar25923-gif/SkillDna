generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  targetCareer  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  profile       Profile?
  skills        UserSkill[]
  projects      Project[]
  jobDescriptions JobDescription[]
  skillGaps     SkillGap[]
  roadmaps      Roadmap[]
  progress      Progress[]
  achievements  Achievement[]
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  university      String?
  graduationYear  Int?
  linkedin        String?
  github          String?
  portfolio       String?
  resumeText      String?
  resumeFileUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills    UserSkill[]
  careerSkills  CareerSkill[]
  skillGaps     SkillGap[]
  progress      Progress[]
}

model UserSkill {
  id           String   @id @default(cuid())
  userId       String
  skillId      String
  proficiency  Int      @default(0)
  level        String   @default("Beginner")
  evidence     String?
  source       String   @default("self-reported")
  lastAssessed DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Career {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String
  demandLevel String
  avgSalary   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  careerSkills CareerSkill[]
  roadmaps     Roadmap[]
  skillGaps    SkillGap[]
}

model CareerSkill {
  id          String   @id @default(cuid())
  careerId    String
  skillId     String
  importance  Int      @default(5)
  minLevel    Int      @default(3)
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([careerId, skillId])
}

model Project {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  techStack       String
  githubUrl       String?
  projectUrl      String?
  readmeContent   String?
  analysisScore   Int?
  analysisData    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobDescription {
  id              String   @id @default(cuid())
  userId          String
  title           String
  company         String?
  description     String
  requiredSkills  String
  preferredSkills String
  responsibilities String
  experienceLevel String?
  location        String?
  salaryRange     String?
  analysisScore   Int?
  analysisData    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillGap {
  id                String   @id @default(cuid())
  userId            String
  skillId           String
  careerId          String?
  currentLevel      Int      @default(0)
  requiredLevel     Int      @default(5)
  gapType           String
  priority          Int      @default(1)
  reason            String?
  recommendedAction String?
  estimatedEffort   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  career Career? @relation(fields: [careerId], references: [id], onDelete: SetNull)
}

model Roadmap {
  id          String   @id @default(cuid())
  userId      String
  careerId    String
  title       String
  description String?
  totalWeeks  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  career  Career       @relation(fields: [careerId], references: [id], onDelete: Cascade)
  items   RoadmapItem[]
}

model RoadmapItem {
  id              String   @id @default(cuid())
  roadmapId       String
  weekNumber      Int
  title           String
  description     String?
  difficulty      String
  estimatedHours  Int
  reason          String?
  prerequisites   String
  status          String   @default("pending")
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model TechNews {
  id          String   @id @default(cuid())
  title       String
  summary     String
  category    String
  source      String
  sourceUrl   String?
  publishedAt DateTime
  trendStatus String
  importance  Int      @default(3)
  tags        String
  aiAnalysis  String?
  createdAt   DateTime @default(now())
}

model TechTrend {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String
  description   String?
  demandLevel   String
  growthRate    Float?
  relatedSkills String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  date        DateTime @default(now())
  proficiency Int
  source      String
  note        String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String
  metadata    String?
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}